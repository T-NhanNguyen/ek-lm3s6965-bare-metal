# ---------------------------------------------------------------------------
# macOS -- filesystem and Finder cruft.
# .DS_Store records folder view state and can leak filenames of ignored files.
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.fseventsd
.AppleDouble
.LSOverride
Icon?
Network Trash Folder
Temporary Items
.apdisk

# ---------------------------------------------------------------------------
# Build output (CMake + the cross toolchain).
# The .bin/.hex/.map/.elf products are regenerated by `cmake --build build`.
# ---------------------------------------------------------------------------
build/
cmake-build-*/
out/
*.o
*.d
*.elf
*.bin
*.hex
*.map
*.lst
*.su
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json
.cache/

# ---------------------------------------------------------------------------
# Private development journal and agent scratch -- never published.
# ---------------------------------------------------------------------------
.dev-vault/
.pi/

# ---------------------------------------------------------------------------
# Secrets and machine-local configuration -- never commit these.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
secrets.*
credentials.*
*.local
*.private

# ---------------------------------------------------------------------------
# Editors, tooling, and language scratch.
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
__pycache__/
*.py[cod]

# ---------------------------------------------------------------------------
# Python virtual environment for the pyftdi SWO console reader.
# Recreate it with: python3 -m venv .venv && .venv/bin/pip install pyftdi
# ---------------------------------------------------------------------------
.venv/
venv/
