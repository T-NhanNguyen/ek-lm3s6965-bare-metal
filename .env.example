# Literal configuration: paths only, never private key bytes or shell commands.
# PUBLIC paths may be repository-relative; PRIVATE must be absolute and external.
LM3S6965_BOOT_PUBLIC_KEY_FILE=/absolute/path/to/authorized-public.sec1
# Supply your existing authorized P-256 key; package.py enforces modes 0600/0700.
LM3S6965_BOOT_PRIVATE_KEY_FILE=
# Choose authorized decimal uint32 release numbers (0..4294967295) for both slots.
LM3S6965_BOOT_RELEASE_A=
LM3S6965_BOOT_RELEASE_B=
