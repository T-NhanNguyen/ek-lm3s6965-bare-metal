#!/usr/bin/env python3
"""Build FTP images, then publish one signed release pair using the existing packager."""
import fcntl
import os
from pathlib import Path
import re
import shlex
import stat
import subprocess
import sys
import tempfile

PREFIX = "LM3S6965_BOOT_"
KEYS = tuple(PREFIX + name for name in
             ("PUBLIC_KEY_FILE", "PRIVATE_KEY_FILE", "RELEASE_A", "RELEASE_B"))


def configuration(repo):
    """Read bounded literal data, never shell source or inherited configuration."""
    fd = os.open(repo / ".env", os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
    with os.fdopen(fd, "rb") as source:
        if not stat.S_ISREG(os.fstat(source.fileno()).st_mode):
            raise ValueError(".env must be a regular file (not a symlink)")
        data = source.read(4097)
    if len(data) > 4096:
        raise ValueError(".env exceeds 4096-byte limit")
    text = data.decode("utf-8")
    if any(((ord(c) < 32) and (c not in "\t\r\n")) or ord(c) == 127 for c in text):
        raise ValueError(".env contains control characters")
    values = {}
    for number, line in enumerate(text.splitlines(), 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        match = re.fullmatch(r"([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)", line)
        if match is None:
            raise ValueError(f"malformed assignment on line {number}")
        name, raw = match.groups()
        if name not in KEYS:
            raise ValueError(f"unknown key on line {number}; allowed: {', '.join(KEYS)}")
        if name in values:
            raise ValueError(f"duplicate {name}")
        if raw.startswith(("'", '"')):
            if len(raw) < 2 or raw[-1] != raw[0] or raw[0] in raw[1:-1]:
                raise ValueError(f"malformed quotes on line {number}")
            raw = raw[1:-1]
        elif "'" in raw or '"' in raw:
            raise ValueError(f"malformed quotes on line {number}")
        values[name] = raw
    missing = [key for key in KEYS if not values.get(key, "").strip()]
    if missing:
        raise ValueError("missing or empty assignments: " + ", ".join(missing))
    for key in KEYS[2:]:
        if not re.fullmatch(r"[0-9]{1,10}", values[key]) or int(values[key]) > 0xffffffff:
            raise ValueError(f"{key} must be decimal uint32 (0..4294967295)")
        values[key] = str(int(values[key]))
    private = Path(values[KEYS[1]])
    if not private.is_absolute() or private.resolve().is_relative_to(repo):
        raise ValueError(f"{KEYS[1]} must be an absolute path outside the repository")
    # Do not open private material: package.py owns file modes, aliases and key matching.
    return values


def main():
    if len(sys.argv) > 2:
        print("Usage: scripts/build_ab_boot_demo [PUBLIC_KEY_FILE]", file=sys.stderr)
        return 2
    repo = Path(__file__).resolve().parents[1]
    try:
        config = configuration(repo)
        public = Path(sys.argv[1]) if len(sys.argv) == 2 else Path(config[KEYS[0]])
        if len(sys.argv) == 2 and not sys.argv[1]:
            raise ValueError("PUBLIC key must be a readable regular file")
        if not public.is_absolute():
            public = (Path.cwd() if len(sys.argv) == 2 else repo) / public
        if not public.is_file() or not os.access(public, os.R_OK):
            raise ValueError("PUBLIC key must be a readable regular file")
        release_a, release_b = (config[key] for key in KEYS[2:])
        parent = repo / "build/ab-demo-packages"
        parent.mkdir(parents=True, exist_ok=True)
        final = parent / f"release-{release_a}-{release_b}"
        
        # Diagnostics are forced OFF for the approved packaging build to prevent stale cache state.
        cmake_args = [
            "--preset", "ab-boot-demo",
            f"-D{KEYS[0]}={public}",
            "-DLM3S6965_FTP_DIAGNOSTIC=OFF",
        ]
        
        # Serialize wrapper publishers (including the pre-build refusal check).
        with (parent / ".publish.lock").open("a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            
            # Fail-if-final-exists behavior under lock. Do not overwrite published output.
            if os.path.lexists(final):
                print(f"Package directory already exists: {final}", file=sys.stderr)
                return 2
            
            subprocess.run(["cmake"] + cmake_args, cwd=repo, check=True)
            subprocess.run(["cmake", "--build", "--preset", "ab-boot-demo"],
                           cwd=repo, check=True)
            # Only this newly created temporary directory is ever cleaned up.
            with tempfile.TemporaryDirectory(prefix=".pair-", dir=parent) as temporary:
                staging = Path(temporary)
                for slot, directory, release in (("A", "slot-a-breathing", release_a),
                                                 ("B", "slot-b-blink", release_b)):
                    subprocess.run([
                        "python3", str(repo / "tools/boot/package.py"),
                        "--input", str(repo / "build/examples/ab-boot-demo" / directory /
                                       f"lm3s6965_ab_ftp_{slot.lower()}.bin"),
                        "--input-format", "bin", "--slot", slot, "--release", release,
                        "--private-key", config[KEYS[1]], "--public-key", str(public),
                        "--output", str(staging / f"slot-{slot.lower()}.pkg"),
                    ], cwd=repo, check=True)
                staging.rename(final)
        print(shlex.join([str(repo / "scripts/ab-boot-firmwareflash-ftp.sh"),
                          "download", str(final)]))
        return 0
    except subprocess.CalledProcessError as error:
        # Do not echo command arguments (which contain the private file path).
        print("A/B build/package command failed; no release pair published", file=sys.stderr)
        return error.returncode if error.returncode > 0 else 1
    except (ValueError, OSError, UnicodeError) as error:
        # Filesystem diagnostics can contain sensitive paths; configuration errors name keys.
        detail = str(error) if isinstance(error, ValueError) else "filesystem operation failed"
        print("repository .env: " + detail, file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
